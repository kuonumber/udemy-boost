{
  "manifest_version": 3,
  "name": "Udemy Boost",
  "version": "0.6.0",
  "description": "Udemy 學習增強：中英對照字幕、簡轉繁、機翻、可拖動字幕、一鍵下載課程資源、學習歷程與專注度分析（CSV / Markdown 直寫）、GPT 學習包與 Anki 卡片同步。",
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.udemy.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.udemy.com/course/*/learn/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*.js",
        "src/translate/*.js",
        "src/download/*.js",
        "src/learning/*.js",
        "src/focus/*.js",
        "src/fs/*.js",
        "src/anki/*.js",
        "vendor/*.js"
      ],
      "matches": [
        "https://www.udemy.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Udemy Boost",
    "default_popup": "options/options.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
